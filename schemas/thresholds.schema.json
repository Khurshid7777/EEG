{
  "$defs": {
    "ModeBGates": {
      "additionalProperties": false,
      "description": "Gates for autonomous mode B (TZ §2).",
      "properties": {
        "min_confidence": {
          "default": 0.85,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Confidence",
          "type": "number"
        },
        "min_signal_quality": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Signal Quality",
          "type": "number"
        },
        "max_artifact_fraction": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Artifact Fraction",
          "type": "number"
        },
        "require_plausible": {
          "default": true,
          "title": "Require Plausible",
          "type": "boolean"
        }
      },
      "title": "ModeBGates",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Confidence thresholds and alarm budgets (TZ §2, §10, §16).",
  "properties": {
    "detection_min_confidence": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Detection Min Confidence",
      "type": "number"
    },
    "mode_b": {
      "$ref": "#/$defs/ModeBGates"
    },
    "max_false_alarms_per_hour": {
      "default": 2.0,
      "description": "cEEG alarm budget (placeholder for real-time, v2).",
      "minimum": 0,
      "title": "Max False Alarms Per Hour",
      "type": "number"
    },
    "diffuse_slowing_delta_theta_ratio": {
      "default": 0.55,
      "maximum": 1,
      "minimum": 0,
      "title": "Diffuse Slowing Delta Theta Ratio",
      "type": "number"
    },
    "asymmetry_index_abnormal": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Asymmetry Index Abnormal",
      "type": "number"
    },
    "suppression_amplitude_uv": {
      "default": 10.0,
      "exclusiveMinimum": 0,
      "title": "Suppression Amplitude Uv",
      "type": "number"
    },
    "burst_suppression_ratio": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "title": "Burst Suppression Ratio",
      "type": "number"
    },
    "ictal_min_duration_s": {
      "default": 8.0,
      "exclusiveMinimum": 0,
      "title": "Ictal Min Duration S",
      "type": "number"
    },
    "ictal_rhythmicity": {
      "default": 0.45,
      "maximum": 1,
      "minimum": 0,
      "title": "Ictal Rhythmicity",
      "type": "number"
    },
    "ictal_amplitude_factor": {
      "default": 1.5,
      "minimum": 1,
      "title": "Ictal Amplitude Factor",
      "type": "number"
    },
    "ictal_min_channels": {
      "default": 1,
      "minimum": 1,
      "title": "Ictal Min Channels",
      "type": "integer"
    },
    "generalized_channel_fraction": {
      "default": 0.6,
      "maximum": 1,
      "minimum": 0,
      "title": "Generalized Channel Fraction",
      "type": "number"
    },
    "pd_min_discharges": {
      "default": 6,
      "minimum": 3,
      "title": "Pd Min Discharges",
      "type": "integer"
    },
    "pd_isi_cv_max": {
      "default": 0.35,
      "description": "Max ISI coeff. of variation.",
      "minimum": 0,
      "title": "Pd Isi Cv Max",
      "type": "number"
    },
    "pd_freq_hz_min": {
      "default": 0.5,
      "exclusiveMinimum": 0,
      "title": "Pd Freq Hz Min",
      "type": "number"
    },
    "pd_freq_hz_max": {
      "default": 3.0,
      "exclusiveMinimum": 0,
      "title": "Pd Freq Hz Max",
      "type": "number"
    },
    "pd_plus_fast_ratio": {
      "default": 0.15,
      "description": "Beta+gamma frac -> +F.",
      "maximum": 1,
      "minimum": 0,
      "title": "Pd Plus Fast Ratio",
      "type": "number"
    },
    "rda_min_duration_s": {
      "default": 6.0,
      "exclusiveMinimum": 0,
      "title": "Rda Min Duration S",
      "type": "number"
    },
    "rda_rhythmicity": {
      "default": 0.4,
      "maximum": 1,
      "minimum": 0,
      "title": "Rda Rhythmicity",
      "type": "number"
    },
    "rda_autocorr_min": {
      "default": 0.7,
      "description": "Delta-band autocorrelation at one period (6 s windows) for a channel to count as rhythmic (increment 17; replaces the spectral-concentration test).",
      "maximum": 1,
      "minimum": 0,
      "title": "Rda Autocorr Min",
      "type": "number"
    },
    "pd_mimic_uncertain": {
      "default": true,
      "description": "Mark periodic patterns matching an ECG/ocular mimic as artifact hypotheses (increment 18; switched by its decision).",
      "title": "Pd Mimic Uncertain",
      "type": "boolean"
    },
    "pd_ecg_freq_hz": {
      "default": [
        0.75,
        2.0
      ],
      "description": "Cardiac rate range (45-120 /min) for the ECG-mimic check.",
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Pd Ecg Freq Hz",
      "type": "array"
    },
    "pd_ecg_isi_cv_max": {
      "default": 0.05,
      "description": "Below this inter-discharge CV at cardiac rate the pattern is an ECG-artefact hypothesis (increment 18; 0.10 in increment 20: physiologic sinus arrhythmia).",
      "minimum": 0,
      "title": "Pd Ecg Isi Cv Max",
      "type": "number"
    },
    "pd_ecg_freq_hz_by_age": {
      "description": "Increment 20: age-specific cardiac rate ranges [(age_below_years, lo_hz, hi_hz)], first matching row wins; older patients (or unknown age) use pd_ecg_freq_hz.",
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Pd Ecg Freq Hz By Age",
      "type": "array"
    },
    "spike_candidate_rank": {
      "default": "confidence",
      "description": "Order of heuristic spike candidates before the cap: saturated confidence (channel order on ties) or raw sharpness z (increment 21).",
      "pattern": "^(confidence|sharpness)$",
      "title": "Spike Candidate Rank",
      "type": "string"
    },
    "pdr_method": {
      "default": "whole",
      "description": "Posterior dominant rhythm estimate: whole-record spectral peak, or 'alert' - upper quartile of 10-s epoch peaks (increment 20).",
      "pattern": "^(whole|alert)$",
      "title": "Pdr Method",
      "type": "string"
    },
    "pdr_posterior_dominance_min": {
      "default": 0.0,
      "description": "Increment 37: the PDR peak counts only if its power over O1/O2 is at least this multiple of that over F3/F4 (a posterior dominant rhythm is posterior); 0 = off.",
      "minimum": 0,
      "title": "Pdr Posterior Dominance Min",
      "type": "number"
    },
    "field_required": {
      "default": false,
      "description": "Increment 20: lateralized PDs/RDA whose channels contain no two neighbouring electrodes are 'no field' hypotheses (uncertain).",
      "title": "Field Required",
      "type": "boolean"
    },
    "ictal_ml_routine_uncertain": {
      "default": false,
      "description": "Increment 20: learned seizure events on routine-length EEG (shorter than routine_max_duration_s, not neonatal) are candidates for review - the model was validated on long-term monitoring only.",
      "title": "Ictal Ml Routine Uncertain",
      "type": "boolean"
    },
    "routine_max_duration_s": {
      "default": 2700.0,
      "description": "Recordings shorter than this (45 min) are routine EEG.",
      "exclusiveMinimum": 0,
      "title": "Routine Max Duration S",
      "type": "number"
    },
    "pd_min_duration_s": {
      "default": 10.0,
      "description": "ACNS: < 10 s = very brief.",
      "exclusiveMinimum": 0,
      "title": "Pd Min Duration S",
      "type": "number"
    },
    "focal_slowing_min_diff": {
      "default": 0.25,
      "description": "Persistent difference of relative delta+theta power between homologous channels (median over epochs, same sign in >= 70% of epochs).",
      "maximum": 1,
      "minimum": 0,
      "title": "Focal Slowing Min Diff",
      "type": "number"
    },
    "grda_min_windows": {
      "default": 2,
      "description": "Consecutive 6 s windows (hop 2 s): 2 = 8 s.",
      "minimum": 1,
      "title": "Grda Min Windows",
      "type": "integer"
    },
    "lrda_min_windows": {
      "default": 3,
      "description": "Consecutive 6 s windows (hop 2 s): 3 = 10 s.",
      "minimum": 1,
      "title": "Lrda Min Windows",
      "type": "integer"
    },
    "iic_freq_hz_min": {
      "default": 1.5,
      "exclusiveMinimum": 0,
      "title": "Iic Freq Hz Min",
      "type": "number"
    },
    "iic_freq_hz_max": {
      "default": 2.5,
      "exclusiveMinimum": 0,
      "title": "Iic Freq Hz Max",
      "type": "number"
    },
    "firda_max_continuous_fraction": {
      "default": 0.7,
      "maximum": 1,
      "minimum": 0,
      "title": "Firda Max Continuous Fraction",
      "type": "number"
    },
    "firda_min_runs": {
      "default": 2,
      "minimum": 1,
      "title": "Firda Min Runs",
      "type": "integer"
    },
    "edb_beta_ratio": {
      "default": 0.12,
      "maximum": 1,
      "minimum": 0,
      "title": "Edb Beta Ratio",
      "type": "number"
    }
  },
  "title": "Thresholds",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
